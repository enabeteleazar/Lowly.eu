{
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/index.php",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/contacts",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/newsletter/subscriptions",
      "destination": "/newsletter",
      "permanent": true
    },
    {
      "source": "/user/login",
      "destination": "/contact",
      "permanent": true
    },
    {
      "source": "/user/register",
      "destination": "/contact",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
